<Project Sdk="Microsoft.NET.Sdk">
  <!-- WinUI 3 앱. 설치 패키지(MSIX) 없이 실행하고(unpackaged), .NET과 Windows App SDK를 앱 폴더에 함께 넣는다(self-contained).
       Windows에서만 빌드할 수 있다(XAML 컴파일러가 Windows 전용). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>Stow</RootNamespace>
    <AssemblyName>Stow</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <!-- 설치 패키지가 없어도 화면 리소스 파일(Stow.pri, 컴파일된 XAML 포함)을 만들게 한다.
         없으면 첫 창을 불러오다 실패해 앱이 아무것도 띄우지 못하고 꺼진다. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- 셸 API 호출(LibraryImport가 만드는 마샬링 코드에 필요) -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.5" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2957" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Stow.Core\Stow.Core.csproj" />
  </ItemGroup>

  <!-- 엔진(Python·yt-dlp·deno·ffmpeg): scripts/fetch-engine.sh·build-ffmpeg.sh가 만든 engine/<RID>를 앱 폴더의 engine\로 복사한다.
       Content가 아니라 None으로 넣어 화면 리소스(PRI) 색인에 들어가지 않게 한다. 폴더가 없으면 엔진 없이 빌드된다. -->
  <PropertyGroup>
    <StowEngineDir>$(MSBuildThisFileDirectory)..\..\engine\$(RuntimeIdentifier)\</StowEngineDir>
  </PropertyGroup>
  <ItemGroup Condition="'$(RuntimeIdentifier)' != '' And Exists('$(StowEngineDir)')">
    <None Include="$(StowEngineDir)**\*" LinkBase="engine" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- 배포용(Release) publish에 엔진이 없으면 멈춘다(엔진 없는 앱이 조용히 만들어지지 않게). -->
  <Target Name="StowRequireEngine" BeforeTargets="PrepareForPublish"
          Condition="'$(Configuration)' == 'Release' And !Exists('$(StowEngineDir)ffmpeg.exe')">
    <Error Text="엔진이 없습니다: $(StowEngineDir). 먼저 windows/scripts/fetch-engine.sh와 build-ffmpeg.sh를 실행하세요." />
  </Target>
</Project>
