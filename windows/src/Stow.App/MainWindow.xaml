<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Stow.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Stow">
    <!-- 배경: Mica를 쓸 수 있으면(Windows 11) Mica, 아니면(Windows 10) 기본 단색. 코드에서 정한다. -->
    <Grid x:Name="RootGrid">
        <ScrollViewer>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" MaxWidth="520" Margin="24">
            <TextBlock Text="Stow" Style="{StaticResource TitleTextBlockStyle}" HorizontalAlignment="Center" />
            <TextBlock x:Name="VersionText"
                       Style="{StaticResource BodyTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       HorizontalAlignment="Center" />
            <!-- 개발 확인용: 앱에 넣은 엔진이 이 PC에서 실행되는지 보여 준다. -->
            <TextBlock Text="엔진 확인" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,24,0,0" />
            <ProgressRing x:Name="EngineProgress" IsActive="True" HorizontalAlignment="Left" Width="20" Height="20" />
            <ItemsControl x:Name="EngineResults">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Margin="0,2" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 개발 확인용: 실제 유튜브 주소로 받아 본다(결과는 "다운로드" 폴더). 메인 화면이 생기면 없앤다. -->
            <TextBlock Text="다운로드 시험" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,24,0,0" />
            <TextBox x:Name="UrlBox" PlaceholderText="유튜브 영상·재생목록 주소를 붙여 넣으세요" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <ComboBox x:Name="FormatBox" SelectedIndex="0" MinWidth="160">
                    <x:String>MP3 320kbps</x:String>
                    <x:String>WAV</x:String>
                    <x:String>FLAC</x:String>
                    <x:String>MP4 1080p</x:String>
                    <x:String>최고 화질</x:String>
                </ComboBox>
                <Button x:Name="DownloadButton" Content="받기" Style="{StaticResource AccentButtonStyle}" Click="OnDownload" />
                <Button x:Name="CancelButton" Content="취소" IsEnabled="False" Click="OnCancel" />
            </StackPanel>
            <ProgressBar x:Name="DownloadProgress" Maximum="1" Value="0" />
            <TextBlock x:Name="DownloadStatus" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
