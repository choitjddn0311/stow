<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Stow.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Stow"
    xmlns:features="using:Stow.Core.Features"
    Title="Stow">

    <!-- 두 칸: 왼쪽 주소·영상 정보·출력, 오른쪽 대기열. 창이 좁으면 한 줄로 접는다.
         모양은 Windows 11 설정 앱의 카드 줄(아이콘 · 제목·설명 · 오른쪽 컨트롤). 배경은 코드에서(Mica 또는 단색). -->
    <Grid x:Name="RootGrid">
        <Grid.Resources>
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
                <Setter Property="Padding" Value="16,12" />
                <Setter Property="MinHeight" Value="64" />
            </Style>
            <Style x:Key="SectionStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Margin" Value="2,18,0,6" />
            </Style>
            <Style x:Key="CardIconStyle" TargetType="FontIcon">
                <Setter Property="FontSize" Value="18" />
                <Setter Property="Margin" Value="0,0,16,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="CardDescriptionStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftColumn" Width="*" />
            <ColumnDefinition x:Name="RightColumn" Width="*" />
        </Grid.ColumnDefinitions>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="900" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <!-- 한 줄: 왼쪽 칸 아래에 대기열 -->
                        <Setter Target="RightColumn.Width" Value="0" />
                        <Setter Target="LeftPane.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="QueuePane.(Grid.Row)" Value="2" />
                        <Setter Target="QueuePane.(Grid.Column)" Value="0" />
                        <Setter Target="QueuePane.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="QueuePane.BorderThickness" Value="0,1,0,0" />
                        <Setter Target="QueuePane.MaxHeight" Value="320" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!-- 엔진 파일이 없을 때(다시 설치 안내) -->
        <InfoBar x:Name="EngineInfoBar" Grid.ColumnSpan="2" Margin="20,12,20,0" Severity="Error" IsClosable="False"
                 Title="추출 엔진을 찾을 수 없습니다" />

        <!-- 왼쪽: 주소 · 영상 정보 · 출력 -->
        <ScrollViewer x:Name="LeftPane" Grid.Row="1" Grid.Column="0" Padding="20,0,20,16" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="4" Padding="0,0,0,16">
                <TextBlock Text="영상" Style="{StaticResource SectionStyle}" />
                <Border Style="{StaticResource CardStyle}">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE71B;" Style="{StaticResource CardIconStyle}" Margin="0,0,8,0" />
                        <TextBox x:Name="UrlBox" Grid.Column="1" PlaceholderText="유튜브 영상·재생목록 주소를 붙여 넣으세요"
                                 Text="{x:Bind ViewModel.UrlText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="OnUrlKeyDown" AutomationProperties.Name="주소" />
                        <Button Grid.Column="2" Content="불러오기" Click="OnFetch" IsEnabled="{x:Bind ViewModel.CanFetch, Mode=OneWay}" />
                    </Grid>
                </Border>

                <!-- 불러오는 중 -->
                <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.IsFetching, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <ProgressRing IsActive="{x:Bind ViewModel.IsFetching, Mode=OneWay}" Width="20" Height="20" />
                        <TextBlock Text="영상 정보를 불러오는 중…" VerticalAlignment="Center" />
                        <HyperlinkButton Content="취소" Click="OnCancelFetch" />
                    </StackPanel>
                </Border>

                <!-- 오류 -->
                <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" IsClosable="False" Severity="Error"
                         Title="불러오지 못했습니다" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}">
                    <InfoBar.ActionButton>
                        <Button Content="다시 시도" Click="OnRetryFetch" Visibility="{x:Bind ViewModel.CanRetryFetch, Mode=OneWay}" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <!-- 영상 하나 -->
                <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.HasVideo, Mode=OneWay}">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="128" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border CornerRadius="4" Background="{ThemeResource SubtleFillColorSecondaryBrush}" Height="72">
                            <Image Source="{x:Bind local:Ui.Thumbnail(ViewModel.Video), Mode=OneWay}" Stretch="UniformToFill" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="{x:Bind ViewModel.Video.Title, Mode=OneWay, FallbackValue=''}" Style="{StaticResource BodyStrongTextBlockStyle}"
                                       TextWrapping="Wrap" MaxLines="2" IsTextSelectionEnabled="True" />
                            <TextBlock Text="{x:Bind ViewModel.VideoSubtitle, Mode=OneWay}" Style="{StaticResource CardDescriptionStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 재생목록 -->
                <StackPanel Visibility="{x:Bind ViewModel.HasPlaylist, Mode=OneWay}" Spacing="4">
                    <Grid Margin="2,8,0,4">
                        <StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.Playlist.Title, Mode=OneWay, FallbackValue=''}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind ViewModel.PlaylistSummary, Mode=OneWay}" Style="{StaticResource CardDescriptionStyle}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <HyperlinkButton Content="모두 선택" Click="OnSelectAll" />
                            <HyperlinkButton Content="모두 해제" Click="OnSelectNone" />
                        </StackPanel>
                    </Grid>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.PlaylistEntries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="features:PlaylistEntryItem">
                                <Border Style="{StaticResource CardStyle}" MinHeight="48" Padding="12,6" Margin="0,0,0,2">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" Content="{x:Bind Title}" IsEnabled="{x:Bind IsAvailable}" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind DurationText}" VerticalAlignment="Center"
                                                   Style="{StaticResource CardDescriptionStyle}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <TextBlock Text="출력" Style="{StaticResource SectionStyle}" />
                <!-- 종류 -->
                <Border Style="{StaticResource CardStyle}" CornerRadius="4,4,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon x:Name="KindIcon" Glyph="&#xE8D6;" Style="{StaticResource CardIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="종류" />
                            <TextBlock Text="오디오만 추출하거나 영상을 받습니다" Style="{StaticResource CardDescriptionStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <ToggleButton x:Name="AudioKindButton" Content="오디오" Click="OnKindClick" Tag="audio" />
                            <ToggleButton x:Name="VideoKindButton" Content="영상" Click="OnKindClick" Tag="video" />
                        </StackPanel>
                    </Grid>
                </Border>
                <!-- 포맷 -->
                <Border Style="{StaticResource CardStyle}" CornerRadius="0" Margin="0,-5,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE9D9;" Style="{StaticResource CardIconStyle}" />
                        <TextBlock Grid.Column="1" Text="포맷" VerticalAlignment="Center" />
                        <StackPanel x:Name="FormatButtons" Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <!-- 음질 / 해상도 -->
                <Border Style="{StaticResource CardStyle}" CornerRadius="0" Margin="0,-5,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon x:Name="QualityIcon" Glyph="&#xE9E9;" Style="{StaticResource CardIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="QualityLabel" Text="음질" />
                            <TextBlock x:Name="QualityDescription" Style="{StaticResource CardDescriptionStyle}" />
                        </StackPanel>
                        <ComboBox x:Name="QualityBox" Grid.Column="2" MinWidth="150" VerticalAlignment="Center" SelectionChanged="OnQualityChanged"
                                  AutomationProperties.Name="음질 또는 해상도" />
                    </Grid>
                </Border>
                <!-- 저장 위치 -->
                <Border Style="{StaticResource CardStyle}" CornerRadius="0,0,4,4" Margin="0,-5,0,0">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8B7;" Style="{StaticResource CardIconStyle}" Margin="0,0,8,0" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="저장 위치" />
                            <TextBlock Text="{x:Bind ViewModel.Settings.OutputDirectory, Mode=OneWay}" Style="{StaticResource CardDescriptionStyle}"
                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" IsTextSelectionEnabled="True" />
                        </StackPanel>
                        <Button Grid.Column="2" Content="찾아보기…" Click="OnChooseFolder" />
                    </Grid>
                </Border>
                <TextBlock x:Name="FormatNote" Style="{StaticResource CardDescriptionStyle}" Margin="2,6,0,0" />

                <TextBlock Text="빠른 추출" Style="{StaticResource SectionStyle}" />
                <Border Style="{StaticResource CardStyle}">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE765;" Style="{StaticResource CardIconStyle}" Margin="0,0,8,0" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="단축키" />
                            <TextBlock x:Name="HotKeyDescription" Style="{StaticResource CardDescriptionStyle}" />
                        </StackPanel>
                        <ItemsControl x:Name="HotKeyKeys" Grid.Column="2" VerticalAlignment="Center" IsTabStop="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Border BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1,1,1,2"
                                            Background="{ThemeResource ControlFillColorDefaultBrush}" CornerRadius="4" Padding="8,2">
                                        <TextBlock Text="{x:Bind}" Style="{StaticResource CaptionTextBlockStyle}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Grid.Column="3" Content="변경" Click="OnChangeHotKey" Margin="8,0,0,0" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource CardStyle}">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE7C4;" Style="{StaticResource CardIconStyle}" Margin="0,0,8,0" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="창을 닫으면 트레이에 남기" />
                            <TextBlock Text="끄면 창을 닫을 때 Stow가 완전히 끝나고 단축키도 동작하지 않습니다." Style="{StaticResource CardDescriptionStyle}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="2" MinWidth="0" OnContent="켬" OffContent="끔" AutomationProperties.Name="창을 닫으면 트레이에 남기"
                                      IsOn="{x:Bind ViewModel.Settings.KeepRunningInTray, Mode=TwoWay}" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource CardStyle}">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE7E8;" Style="{StaticResource CardIconStyle}" Margin="0,0,8,0" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Windows를 시작할 때 실행" />
                            <TextBlock Text="창 없이 트레이에서 조용히 시작해 바로 단축키를 쓸 수 있습니다." Style="{StaticResource CardDescriptionStyle}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="StartupSwitch" Grid.Column="2" MinWidth="0" OnContent="켬" OffContent="끔"
                                      AutomationProperties.Name="Windows를 시작할 때 실행" Toggled="OnStartupToggled" />
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 오른쪽: 대기열(좁은 창에서는 왼쪽 칸 아래로 옮긴다) -->
        <Border x:Name="QueuePane" Grid.Row="1" Grid.Column="1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1,0,0,0">
            <Grid Padding="20,0,20,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="0,12,0,6">
                    <TextBlock Text="대기열" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" Margin="2,0,0,0" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <HyperlinkButton Content="완료 항목 지우기" Click="OnClearFinished" IsEnabled="{x:Bind ViewModel.Queue.HasFinishedItems, Mode=OneWay}" />
                        <HyperlinkButton Content="모두 취소" Click="OnCancelAll" IsEnabled="{x:Bind ViewModel.Queue.HasPendingItems, Mode=OneWay}" />
                    </StackPanel>
                </Grid>
                <!-- 유튜브가 요청을 막아 멈췄을 때 -->
                <InfoBar Grid.Row="1" IsOpen="{x:Bind local:Ui.HasText(ViewModel.Queue.BlockedMessage), Mode=OneWay}" IsClosable="False"
                         Severity="Warning" Title="대기열을 멈췄습니다" Message="{x:Bind ViewModel.Queue.BlockedMessage, Mode=OneWay}" Margin="0,0,0,6">
                    <InfoBar.ActionButton>
                        <Button Content="다시 시도" Click="OnResumeQueue" />
                    </InfoBar.ActionButton>
                </InfoBar>
                <TextBlock Grid.Row="2" Text="주소를 불러와 추가하면 여기에서 차례로 받습니다." Style="{StaticResource CardDescriptionStyle}"
                           Margin="2,4,0,0" Visibility="{x:Bind ViewModel.Queue.IsEmpty, Mode=OneWay}" />
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,0,16">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Queue.Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="features:QueueItem">
                                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,4">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="{x:Bind local:Ui.StatusGlyph(Status), Mode=OneWay}" FontSize="16" VerticalAlignment="Top" Margin="0,2,0,0"
                                                  Foreground="{x:Bind local:Ui.StatusBrush(Status), Mode=OneWay}" />
                                        <StackPanel Grid.Column="1" Spacing="6">
                                            <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Title}" />
                                            <ProgressBar Visibility="{x:Bind IsRunning, Mode=OneWay}" Maximum="1" Value="{x:Bind ProgressValue, Mode=OneWay}"
                                                         IsIndeterminate="{x:Bind IsProgressIndeterminate, Mode=OneWay}" />
                                            <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" Style="{StaticResource CardDescriptionStyle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                            <Button Tag="{x:Bind}" Click="OnRevealItem" Visibility="{x:Bind CanReveal, Mode=OneWay}" ToolTipService.ToolTip="탐색기에서 보기"
                                                    AutomationProperties.Name="탐색기에서 보기" Style="{StaticResource SubtleButtonStyle}">
                                                <FontIcon Glyph="&#xE838;" FontSize="14" />
                                            </Button>
                                            <Button Tag="{x:Bind}" Click="OnRetryItem" Visibility="{x:Bind CanRetry, Mode=OneWay}" ToolTipService.ToolTip="다시 시도"
                                                    AutomationProperties.Name="다시 시도" Style="{StaticResource SubtleButtonStyle}">
                                                <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                            </Button>
                                            <Button Tag="{x:Bind}" Click="OnCancelItem" Visibility="{x:Bind CanCancel, Mode=OneWay}" ToolTipService.ToolTip="취소"
                                                    AutomationProperties.Name="취소" Style="{StaticResource SubtleButtonStyle}">
                                                <FontIcon Glyph="&#xE711;" FontSize="14" />
                                            </Button>
                                            <Button Tag="{x:Bind}" Click="OnRemoveItem" Visibility="{x:Bind CanRemove, Mode=OneWay}" ToolTipService.ToolTip="목록에서 빼기"
                                                    AutomationProperties.Name="목록에서 빼기" Style="{StaticResource SubtleButtonStyle}">
                                                <FontIcon Glyph="&#xE738;" FontSize="14" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- 명령 막대 -->
        <Grid Grid.Row="3" Grid.ColumnSpan="2" Padding="20,12" ColumnSpacing="12"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Bind ViewModel.Queue.SummaryText, Mode=OneWay}" VerticalAlignment="Center"
                       Style="{StaticResource CardDescriptionStyle}" />
            <Button Grid.Column="1" Style="{StaticResource AccentButtonStyle}" Content="{x:Bind ViewModel.AddButtonTitle, Mode=OneWay}"
                    IsEnabled="{x:Bind ViewModel.CanAddToQueue, Mode=OneWay}" Click="OnAddToQueue" />
        </Grid>
    </Grid>
</Window>
