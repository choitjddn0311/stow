<Project Sdk="Microsoft.NET.Sdk">
  <!-- 화면과 무관한 로직. Windows가 아닌 곳(Mac·Linux)에서도 빌드·테스트한다. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Stow.Core</RootNamespace>
    <!-- Windows Job Object 호출(LibraryImport가 만드는 마샬링 코드에 필요) -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Stow.Core.Tests" />
  </ItemGroup>
</Project>
