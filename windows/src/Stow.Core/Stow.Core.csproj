<Project Sdk="Microsoft.NET.Sdk">
  <!-- 화면과 무관한 로직. Windows가 아닌 곳(Mac·Linux)에서도 빌드·테스트한다. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Stow.Core</RootNamespace>
    <!-- Windows Job Object 호출(LibraryImport가 만드는 마샬링 코드에 필요) -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Stow.Core.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- 앱 업데이트 소스(Windows 릴리스만 고르기)를 테스트할 수 있게 Core에 둔다. 앱·CI의 vpk와 같은 버전. -->
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>
</Project>
