  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Stow.Core/Stow.Core.csproj" />
  </ItemGroup>
</Project>
